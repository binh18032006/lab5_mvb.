        {
          "name": "6. POST User - Duplicate Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 422 Unprocessable Entity\", () => {\n  pm.response.to.have.status(422);\n});\n\npm.test(\"Error points at the email field\", () => {\n  const body = pm.response.json();\n  pm.expect(body).to.be.an(\"array\");\n  pm.expect(body[0].field).to.eql(\"email\");\n});\n\npm.sendRequest({\n  url: \"https://gorest.co.in/public/v2/users/\" + pm.environment.get(\"dupUserId\"),\n  method: \"DELETE\",\n  header: { \"Authorization\": \"Bearer \" + pm.environment.get(\"token\") }\n}, () => {});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = `dup_${Date.now()}@example.com`;\npm.sendRequest({\n  url: \"https://gorest.co.in/public/v2/users\",\n  method: \"POST\",\n  header: {\n    \"Authorization\": \"Bearer \" + pm.environment.get(\"token\"),\n    \"Content-Type\": \"application/json\"\n  },\n  body: {\n    mode: \"raw\",\n    raw: JSON.stringify({ name: \"Dup Seed\", gender: \"male\", email: email, status: \"active\" })\n  }\n}, (err, res) => {\n  pm.environment.set(\"dupEmail\", email);\n  pm.environment.set(\"dupUserId\", res.json().id);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dup Test\",\n  \"gender\": \"male\",\n  \"email\": \"{{dupEmail}}\",\n  \"status\": \"active\"\n}",
              "options": {
