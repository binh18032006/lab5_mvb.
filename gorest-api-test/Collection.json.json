  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "1. POST User (DDT)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Read one row of users.csv for this iteration (fallback values when run without a data file)\nconst data = pm.iterationData;\nconst rawEmail = data.get('email') || 'lab05.user@example.com';\nconst parts = rawEmail.split('@');\n\n// GoRest requires globally unique emails, so add a timestamp to the CSV email\nconst uniqueEmail = parts[0] + '.' + Date.now() + '@' + parts[1];\n\npm.collectionVariables.set('userName', data.get('name') || 'Nguyen Van An');\npm.collectionVariables.set('userGender', data.get('gender') || 'male');\npm.collectionVariables.set('userStatus', data.get('status') || 'active');\npm.collectionVariables.set('userEmail', uniqueEmail);\n\nconsole.log('Iteration ' + (pm.info.iteration + 1) + ' -> ' + uniqueEmail);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));\n\nif (pm.response.code === 201) {\n    const body = pm.response.json();\n    pm.collectionVariables.set(\"userId\", body.id);\n    pm.collectionVariables.set(\"lastEmail\", body.email);\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"gender\": \"{{gender}}\",\n  \"email\": \"{{$timestamp}}_{{email}}\",\n  \"status\": \"{{status}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://gorest.co.in/public/v2/users",
              "protocol": "https",
              "host": [
                "gorest",
                "co",
                "in"
              ],
              "path": [
                "public",
                "v2",
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. GET User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));\n\npm.test(\"Returned user matches the created user\", () => {\n    const body = pm.response.json();\n    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get(\"userId\")));\n    pm.expect(body.email).to.eql(pm.collectionVariables.get(\"lastEmail\"));\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. PATCH User - inactive",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Run the duplicate-email negative test BEFORE the user is deleted",
                  "postman.setNextRequest('5. POST User - No Token');",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Status changed to inactive', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('inactive');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inactive\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "4. DELETE User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Right after DELETE, verify the user is really gone (request 7)",
                  "postman.setNextRequest('7. GET User - After Delete');",
                  "",
                  "pm.test('Status code is 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test('Response body is empty', function () {",
                  "    pm.expect(pm.response.text()).to.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
