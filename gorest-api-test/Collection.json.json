              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"gender\": \"{{userGender}}\",\n  \"email\": \"no.token.{{userEmail}}\",\n  \"status\": \"{{userStatus}}\"\n}",
              "options": {
